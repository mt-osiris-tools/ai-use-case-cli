#!/bin/bash
# AI Use Case - CLI Tool
#
# Hybrid CLI and Claude Code integration for AI use case documentation
# - Standalone commands for utility operations
# - Claude Code slash commands for AI-context-aware operations

set -e

# Colors
GREEN=$'\033[0;32m'
BLUE=$'\033[0;34m'
YELLOW=$'\033[1;33m'
RED=$'\033[0;31m'
CYAN=$'\033[0;36m'
NC=$'\033[0m'

# Get script directory (resolve symlinks)
SCRIPT_PATH="${BASH_SOURCE[0]}"
if [ -L "$SCRIPT_PATH" ]; then
    SCRIPT_PATH="$(readlink -f "$SCRIPT_PATH")"
fi
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

# Source version configuration (single source of truth)
if [ -f "$SCRIPT_DIR/scripts/utils/version.sh" ]; then
    source "$SCRIPT_DIR/scripts/utils/version.sh"
    VERSION="$CLI_VERSION"
else
    # Fallback if version.sh is missing
    echo "Warning: version.sh not found, using fallback version" >&2
    VERSION="unknown"
fi

# Source tracing utilities
if [ -f "$SCRIPT_DIR/scripts/utils/tracing.sh" ]; then
    source "$SCRIPT_DIR/scripts/utils/tracing.sh"
    # Enable tracing for the main CLI script
    enable_script_tracing "ai-use-case" "$@" || true
else
    # Define no-op functions if tracing not available
    trace_command_start() { true; }
    trace_command_end() { true; }
    trace_event() { true; }
    trace_attribute() { true; }
fi

# Show help
show_help() {
    cat <<EOF
${BLUE}╭────────────────────────────────────────────────────────────╮${NC}
${BLUE}│${NC} ${GREEN}AI Use Case CLI${NC} v${VERSION}                                ${BLUE}│${NC}
${BLUE}│${NC} Document AI workflows, build knowledge                 ${BLUE}│${NC}
${BLUE}╰────────────────────────────────────────────────────────────╯${NC}

${YELLOW}USAGE${NC}
  ai-use-case <command> [options]

${YELLOW}COMMANDS${NC}
  ${GREEN}--init, init [--update]${NC}   Setup current project (use --update to refresh)
  ${GREEN}--link-claude${NC}             Create Claude Code symlinks (after Claude setup)
  ${GREEN}config [show|reconfigure]${NC} Show or reconfigure hub settings
  ${GREEN}sync${NC}                      Sync use cases from project to hub
  ${GREEN}search <term>${NC}             Search documented use cases
  ${GREEN}list${NC}                      List all registered projects
  ${GREEN}stats${NC}                     View use case statistics
  ${GREEN}extract [hours] [format]${NC}  Extract session data for reporting
  ${GREEN}view${NC}                      Open hub directory in file explorer
  ${GREEN}push${NC}                      Push hub changes to remote repository
  ${GREEN}publish-confluence${NC}        Publish use case to Confluence
  ${GREEN}agents <subcommand>${NC}       Manage AI agents (list, enable, disable, info)
  ${GREEN}review-quality <file>${NC}     Review documentation quality with AI agent
  ${GREEN}analyze-patterns${NC}          Analyze documentation patterns with AI agent
  ${GREEN}tracing [subcommand]${NC}      Manage tracing configuration
  ${GREEN}reset [options]${NC}           Reset CLI configuration and data
  ${GREEN}update [options]${NC}          Update CLI to latest version
  ${GREEN}bump-version <type>${NC}       Bump version (major|minor|patch)
  ${GREEN}uninstall${NC}                 Uninstall the CLI tool
  ${GREEN}--version, -v, version${NC}    Show version information
  ${GREEN}--help, -h, help${NC}          Show this help message

${YELLOW}CLAUDE CODE INTEGRATION${NC}
  For AI-assisted documentation with automatic context capture:
  ${GREEN}/use-case:document-session${NC}   Document AI session (automatic)
  ${GREEN}/use-case:setup-project${NC}      Setup project (alternative to --init)
  ${GREEN}/use-case:sync-usecases${NC}      Sync to hub (alternative to sync)
  ${GREEN}/use-case:search-usecases${NC}    Search (alternative to search)
  ${GREEN}/use-case:extract-session${NC}    Extract session data (alternative to extract)
  ${GREEN}/use-case:list-projects${NC}      List projects (alternative to list)
  ${GREEN}/use-case:check-updates${NC}      Check updates (alternative to check-updates)
  ${GREEN}/use-case:update-project${NC}     Update project (alternative to update-project)
  ${GREEN}/use-case:publish-confluence${NC} Publish (alternative)
  ${GREEN}/use-case:quick-start${NC}        Quick start guide

${YELLOW}EXAMPLES${NC}
  ai-use-case --init              # Setup current project
  ai-use-case --init --update     # Update project installation
  ai-use-case --link-claude       # Create Claude Code symlinks
  ai-use-case config show         # Show current hub configuration
  ai-use-case config reconfigure  # Change hub mode (local/private)
  ai-use-case sync                # Sync use cases to hub
  ai-use-case search "auth"       # Search for auth-related use cases
  ai-use-case list                # List all projects
  ai-use-case stats               # View statistics
  ai-use-case extract 8 json      # Extract last 8 hours as JSON
  ai-use-case agents list         # List available agents
  ai-use-case agents enable quality-reviewer  # Enable an agent
  ai-use-case review-quality file.md  # Review documentation quality
  ai-use-case analyze-patterns       # Analyze documentation patterns
  ai-use-case analyze-patterns --hub # Analyze patterns across all projects

${YELLOW}PROJECT REGISTRY (v3.1.0+)${NC}
  ${GREEN}list-projects${NC}             List registered projects with versions
  ${GREEN}check-updates${NC}             Check which projects need CLI updates
  ${GREEN}update-project <path>${NC}     Update project to latest CLI version

${YELLOW}ENVIRONMENT${NC}
  AI_USECASES_DIR      Hub directory (default: ~/Documents/ai-use-case-hub)
  AI_USECASES_CLI_ROOT CLI installation directory (default: ~/.local/share/ai-use-case-cli)

${YELLOW}MORE INFO${NC}
  GitHub: ${CYAN}https://github.com/mt-osiris-tools/ai-use-case-cli${NC}
  Issues: ${CYAN}https://github.com/mt-osiris-tools/ai-use-case-cli/issues${NC}

EOF
}

# Parse command
case "${1:-}" in
    --help|-h|help|"")
        show_help
        exit 0
        ;;
    --version|-v)
        echo "ai-use-case version $VERSION"
        exit 0
        ;;
    version)
        echo "${BLUE}ai-use-case${NC} version ${GREEN}$VERSION${NC}"
        exit 0
        ;;
    --init|init)
        trace_event "command_start" "command=init" "args=$*"
        echo -e "${BLUE}Setting up project...${NC}"
        if [ -f "$SCRIPT_DIR/scripts/project/setup-project.sh" ]; then
            # Pass through all remaining arguments (e.g., --update)
            shift
            trace_run "init" bash "$SCRIPT_DIR/scripts/project/setup-project.sh" "$@" .
        else
            trace_event "error" "command=init" "error=script_not_found" "script=setup-project.sh"
            echo -e "${RED}Error: setup-project.sh not found${NC}"
            exit 1
        fi
        ;;
    --link-claude|link-claude)
        trace_event "command_start" "command=link-claude" "working_dir=$(pwd)"
        echo -e "${BLUE}Linking Claude Code commands...${NC}"
        if [ -f "$SCRIPT_DIR/scripts/project/link-claude.sh" ]; then
            trace_run "link-claude" bash "$SCRIPT_DIR/scripts/project/link-claude.sh" .
        else
            trace_event "error" "command=link-claude" "error=script_not_found" "script=link-claude.sh"
            echo -e "${RED}Error: link-claude.sh not found${NC}"
            exit 1
        fi
        ;;
    config)
        if [ -f "$SCRIPT_DIR/scripts/utils/config-manager.sh" ]; then
            case "${2:-show}" in
                show)
                    bash "$SCRIPT_DIR/scripts/utils/config-manager.sh" show
                    ;;
                reconfigure)
                    CONFIG_FILE="$HOME/.config/ai-use-case-cli/config.json"
                    if [ -f "$CONFIG_FILE" ]; then
                        echo -e "${YELLOW}Current configuration will be replaced.${NC}"
                        echo ""
                        bash "$SCRIPT_DIR/scripts/utils/config-manager.sh" show
                        echo ""
                        read -p "Continue with reconfiguration? (y/n) " -n 1 -r
                        echo
                        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                            echo -e "${BLUE}Reconfiguration cancelled${NC}"
                            exit 0
                        fi
                        rm "$CONFIG_FILE"
                        echo -e "${GREEN}✓${NC} Previous configuration removed"
                        echo ""
                    fi
                    bash "$SCRIPT_DIR/scripts/utils/config-manager.sh" init
                    ;;
                *)
                    echo -e "${RED}Error: Unknown config command '${2}'${NC}"
                    echo "Usage: ai-use-case config [show|reconfigure]"
                    exit 1
                    ;;
            esac
        else
            echo -e "${RED}Error: config-manager.sh not found${NC}"
            exit 1
        fi
        ;;
    sync)
        trace_event "command_start" "command=sync" "working_dir=$(pwd)"
        echo -e "${BLUE}Syncing use cases to hub...${NC}"
        if [ -f "$SCRIPT_DIR/scripts/core/sync-ai-use-cases.sh" ]; then
            trace_run "sync" bash "$SCRIPT_DIR/scripts/core/sync-ai-use-cases.sh" .
        else
            trace_event "error" "command=sync" "error=script_not_found" "script=sync-ai-use-cases.sh"
            echo -e "${RED}Error: sync-ai-use-cases.sh not found${NC}"
            exit 1
        fi
        ;;
    search)
        if [ -z "${2:-}" ]; then
            trace_event "error" "command=search" "error=missing_argument" "required=search_term"
            echo -e "${RED}Error: Search term required${NC}"
            echo "Usage: ai-use-case search <term>"
            exit 1
        fi
        trace_event "command_start" "command=search" "search_term=$2"
        if [ -f "$SCRIPT_DIR/scripts/search/search-use-cases.sh" ]; then
            trace_run "search" bash "$SCRIPT_DIR/scripts/search/search-use-cases.sh" "$2"
        else
            trace_event "error" "command=search" "error=script_not_found" "script=search-use-cases.sh"
            echo -e "${RED}Error: search-use-cases.sh not found${NC}"
            exit 1
        fi
        ;;
    list)
        trace_event "command_start" "command=list"
        if [ -f "$SCRIPT_DIR/scripts/project/list-projects.sh" ]; then
            trace_run "list" bash "$SCRIPT_DIR/scripts/project/list-projects.sh"
        else
            trace_event "error" "command=list" "error=script_not_found" "script=list-projects.sh"
            echo -e "${RED}Error: list-projects.sh not found${NC}"
            exit 1
        fi
        ;;
    stats)
        trace_event "command_start" "command=stats"
        if [ -f "$SCRIPT_DIR/scripts/search/stats-use-cases.sh" ]; then
            trace_run "stats" bash "$SCRIPT_DIR/scripts/search/stats-use-cases.sh"
        else
            trace_event "error" "command=stats" "error=script_not_found" "script=stats-use-cases.sh"
            echo -e "${RED}Error: stats-use-cases.sh not found${NC}"
            exit 1
        fi
        ;;
    extract)
        trace_event "command_start" "command=extract" "args=$*"
        if [ -f "$SCRIPT_DIR/scripts/core/extract-session-data.sh" ]; then
            # Pass all arguments to the script
            shift
            trace_run "extract" bash "$SCRIPT_DIR/scripts/core/extract-session-data.sh" "$@"
        else
            trace_event "error" "command=extract" "error=script_not_found" "script=extract-session-data.sh"
            echo -e "${RED}Error: extract-session-data.sh not found${NC}"
            exit 1
        fi
        ;;
    view)
        trace_event "command_start" "command=view"
        if [ -f "$SCRIPT_DIR/scripts/hub/view-hub.sh" ]; then
            trace_run "view" bash "$SCRIPT_DIR/scripts/hub/view-hub.sh"
        else
            trace_event "error" "command=view" "error=script_not_found" "script=view-hub.sh"
            echo -e "${RED}Error: view-hub.sh not found${NC}"
            exit 1
        fi
        ;;
    push)
        trace_event "command_start" "command=push"
        if [ -f "$SCRIPT_DIR/scripts/hub/push-hub.sh" ]; then
            trace_run "push" bash "$SCRIPT_DIR/scripts/hub/push-hub.sh"
        else
            trace_event "error" "command=push" "error=script_not_found" "script=push-hub.sh"
            echo -e "${RED}Error: push-hub.sh not found${NC}"
            exit 1
        fi
        ;;
    publish-confluence)
        trace_event "command_start" "command=publish-confluence" "arg=${2:-}"
        if [ -f "$SCRIPT_DIR/scripts/core/publish-confluence.sh" ]; then
            trace_run "publish-confluence" bash "$SCRIPT_DIR/scripts/core/publish-confluence.sh" "${2:-}"
        else
            trace_event "error" "command=publish-confluence" "error=script_not_found" "script=publish-confluence.sh"
            echo -e "${RED}Error: publish-confluence.sh not found${NC}"
            exit 1
        fi
        ;;
    list-projects)
        trace_event "command_start" "command=list-projects" "arg=${2:-}"
        if [ -f "$SCRIPT_DIR/scripts/project/list-projects.sh" ]; then
            trace_run "list-projects" bash "$SCRIPT_DIR/scripts/project/list-projects.sh" "${2:-}"
        else
            trace_event "error" "command=list-projects" "error=script_not_found" "script=list-projects.sh"
            echo -e "${RED}Error: list-projects.sh not found${NC}"
            exit 1
        fi
        ;;
    check-updates)
        trace_event "command_start" "command=check-updates" "arg=${2:-}"
        if [ -f "$SCRIPT_DIR/scripts/project/check-updates.sh" ]; then
            trace_run "check-updates" bash "$SCRIPT_DIR/scripts/project/check-updates.sh" "${2:-}"
        else
            trace_event "error" "command=check-updates" "error=script_not_found" "script=check-updates.sh"
            echo -e "${RED}Error: check-updates.sh not found${NC}"
            exit 1
        fi
        ;;
    update-project)
        if [ -z "${2:-}" ]; then
            trace_event "error" "command=update-project" "error=missing_argument" "required=project_path"
            echo -e "${RED}Error: Project path required${NC}"
            echo "Usage: ai-use-case update-project [options] <path>"
            exit 1
        fi
        trace_event "command_start" "command=update-project" "args=$*"
        if [ -f "$SCRIPT_DIR/scripts/project/update-project.sh" ]; then
            # Pass through all remaining arguments (e.g., -y, --yes, and path)
            shift
            trace_run "update-project" bash "$SCRIPT_DIR/scripts/project/update-project.sh" "$@"
        else
            trace_event "error" "command=update-project" "error=script_not_found" "script=update-project.sh"
            echo -e "${RED}Error: update-project.sh not found${NC}"
            exit 1
        fi
        ;;
    agents)
        trace_event "command_start" "command=agents" "subcommand=${2:-list}"
        if [ -f "$SCRIPT_DIR/scripts/agents/agent-registry.sh" ]; then
            # Pass all arguments to agent-registry.sh
            shift
            trace_run "agents" bash "$SCRIPT_DIR/scripts/agents/agent-registry.sh" "$@"
        else
            trace_event "error" "command=agents" "error=script_not_found" "script=agent-registry.sh"
            echo -e "${RED}Error: agent-registry.sh not found${NC}"
            echo -e "${YELLOW}Agents feature may not be installed${NC}"
            exit 1
        fi
        ;;
    review-quality)
        trace_event "command_start" "command=review-quality" "file=${2:-none}"
        if [ -f "$SCRIPT_DIR/scripts/agents/quality-agent.sh" ]; then
            # Pass all arguments to quality-agent.sh
            shift
            trace_run "review-quality" bash "$SCRIPT_DIR/scripts/agents/quality-agent.sh" "$@"
        else
            trace_event "error" "command=review-quality" "error=script_not_found" "script=quality-agent.sh"
            echo -e "${RED}Error: quality-agent.sh not found${NC}"
            echo -e "${YELLOW}Quality agent feature may not be installed${NC}"
            exit 1
        fi
        ;;
    analyze-patterns)
        trace_event "command_start" "command=analyze-patterns" "mode=${2:-default}"
        if [ -f "$SCRIPT_DIR/scripts/agents/pattern-agent.sh" ]; then
            # Pass all arguments to pattern-agent.sh
            shift
            trace_run "analyze-patterns" bash "$SCRIPT_DIR/scripts/agents/pattern-agent.sh" "$@"
        else
            trace_event "error" "command=analyze-patterns" "error=script_not_found" "script=pattern-agent.sh"
            echo -e "${RED}Error: pattern-agent.sh not found${NC}"
            echo -e "${YELLOW}Pattern analysis agent feature may not be installed${NC}"
            exit 1
        fi
        ;;
    tracing)
        trace_event "command_start" "command=tracing" "subcommand=${2:-show}"
        if [ -f "$SCRIPT_DIR/scripts/utils/config-manager.sh" ]; then
            case "${2:-show}" in
                init|show|configure|enable|disable|set)
                    trace_run "tracing-${2:-show}" bash "$SCRIPT_DIR/scripts/utils/config-manager.sh" tracing "$2" "${3:-}" "${4:-}"
                    ;;
                status)
                    # Show tracing status using tracing.sh
                    if [ -f "$SCRIPT_DIR/scripts/utils/tracing.sh" ]; then
                        trace_run "tracing-status" bash "$SCRIPT_DIR/scripts/utils/tracing.sh" status
                    else
                        echo "Tracing module not found"
                    fi
                    ;;
                install-deps)
                    # Install tracing dependencies
                    if [ -f "$SCRIPT_DIR/scripts/utils/tracing.sh" ]; then
                        trace_run "tracing-install" bash "$SCRIPT_DIR/scripts/utils/tracing.sh" install-deps
                    else
                        echo "Tracing module not found"
                    fi
                    ;;
                test)
                    # Run tracing test
                    if [ -f "$SCRIPT_DIR/scripts/utils/tracing.sh" ]; then
                        trace_run "tracing-test" bash "$SCRIPT_DIR/scripts/utils/tracing.sh" test
                    else
                        echo "Tracing module not found"
                    fi
                    ;;
                --help|-h|help)
                    cat <<EOF
${BLUE}AI Use Case CLI - Tracing Management${NC}

${YELLOW}Usage:${NC} ai-use-case tracing <subcommand>

${YELLOW}Subcommands:${NC}
  init              Initialize tracing configuration (recommended first step)
  show              Show current tracing configuration
  configure         Interactive tracing configuration setup
  enable            Enable tracing
  disable           Disable tracing
  status            Show tracing system status
  install-deps      Install required Python dependencies
  test              Test tracing functionality
  set <key> <val>   Set tracing configuration value

${YELLOW}Quick Start:${NC}
  ai-use-case tracing init          # Setup tracing (one-time)
  ai-use-case tracing enable        # Enable tracing
  ai-use-case tracing test          # Verify it works

${YELLOW}Examples:${NC}
  ai-use-case tracing show
  ai-use-case tracing configure
  ai-use-case tracing status
  ai-use-case tracing install-deps

${YELLOW}Configuration:${NC}
  Config file: ~/.config/ai-use-case-cli/tracing.json
  Environment variables:
    AI_USECASE_TRACING_ENABLED=true|false
    AI_USECASE_TRACING_ENDPOINT=http://localhost:4318
    AI_USECASE_TRACING_SAMPLING=1.0
EOF
                    ;;
                *)
                    trace_event "error" "command=tracing" "error=unknown_subcommand" "subcommand=${2:-}"
                    echo -e "${RED}Error: Unknown tracing subcommand '${2:-}'${NC}"
                    echo "Run ${CYAN}ai-use-case tracing --help${NC} for available subcommands"
                    exit 1
                    ;;
            esac
        else
            trace_event "error" "command=tracing" "error=config_manager_not_found"
            echo -e "${RED}Error: config-manager.sh not found${NC}"
            exit 1
        fi
        ;;
    reset)
        trace_event "command_start" "command=reset" "args=$*"
        if [ -f "$SCRIPT_DIR/scripts/utils/reset.sh" ]; then
            # Pass all arguments after the command to the script
            shift
            trace_run "reset" bash "$SCRIPT_DIR/scripts/utils/reset.sh" "$@"
        else
            trace_event "error" "command=reset" "error=script_not_found" "script=reset.sh"
            echo -e "${RED}Error: reset.sh not found${NC}"
            exit 1
        fi
        ;;
    update|self-update)
        trace_event "command_start" "command=update" "args=$*"
        if [ -f "$SCRIPT_DIR/scripts/utils/self-update.sh" ]; then
            # Pass all arguments after the command to the script
            shift
            trace_run "update" bash "$SCRIPT_DIR/scripts/utils/self-update.sh" "$@"
        else
            trace_event "error" "command=update" "error=script_not_found" "script=self-update.sh"
            echo -e "${RED}Error: self-update.sh not found${NC}"
            exit 1
        fi
        ;;
    bump-version|bump)
        if [ -z "${2:-}" ]; then
            trace_event "error" "command=bump-version" "error=missing_argument" "required=bump_type"
            echo -e "${RED}Error: Bump type required${NC}"
            echo "Usage: ai-use-case bump-version [major|minor|patch|X.Y.Z] [options]"
            echo "Run: ai-use-case bump-version --help for more information"
            exit 1
        fi
        trace_event "command_start" "command=bump-version" "type=$2" "args=$*"
        if [ -f "$SCRIPT_DIR/scripts/utils/bump-version.sh" ]; then
            # Pass all arguments after the command to the script
            shift
            trace_run "bump-version" bash "$SCRIPT_DIR/scripts/utils/bump-version.sh" "$@"
        else
            trace_event "error" "command=bump-version" "error=script_not_found" "script=bump-version.sh"
            echo -e "${RED}Error: bump-version.sh not found${NC}"
            exit 1
        fi
        ;;
    uninstall)
        trace_event "command_start" "command=uninstall"
        if [ -f "$SCRIPT_DIR/scripts/install/uninstall.sh" ]; then
            trace_run "uninstall" bash "$SCRIPT_DIR/scripts/install/uninstall.sh"
        else
            trace_event "error" "command=uninstall" "error=script_not_found" "script=uninstall.sh"
            echo -e "${RED}Error: uninstall.sh not found${NC}"
            exit 1
        fi
        ;;
    document)
        trace_event "deprecated_command" "command=document" "replacement=/use-case:document-session"
        # Document command removed in v3.0.0 - now uses Claude Code
        cat <<EOF
${YELLOW}╭────────────────────────────────────────────────────────────╮${NC}
${YELLOW}│${NC}  ${RED}⚠ COMMAND CHANGED${NC}                                      ${YELLOW}│${NC}
${YELLOW}│${NC}                                                            ${YELLOW}│${NC}
${YELLOW}│${NC}  The 'document' command now requires Claude Code for     ${YELLOW}│${NC}
${YELLOW}│${NC}  automatic context capture and documentation generation. ${YELLOW}│${NC}
${YELLOW}│${NC}                                                            ${YELLOW}│${NC}
${YELLOW}│${NC}  ${BLUE}Please use:${NC}                                            ${YELLOW}│${NC}
${YELLOW}│${NC}  ${GREEN}/use-case:document-session${NC}                            ${YELLOW}│${NC}
${YELLOW}│${NC}                                                            ${YELLOW}│${NC}
${YELLOW}│${NC}  This provides better AI-assisted documentation with     ${YELLOW}│${NC}
${YELLOW}│${NC}  automatic git history analysis and context awareness.   ${YELLOW}│${NC}
${YELLOW}╰────────────────────────────────────────────────────────────╯${NC}

EOF
        exit 1
        ;;
    *)
        trace_event "error" "command=unknown" "unknown_command=${1}" "available_commands=true"
        echo -e "${RED}Error: Unknown command '${1}'${NC}"
        echo ""
        echo "Run ${CYAN}ai-use-case --help${NC} for available commands"
        exit 1
        ;;
esac
