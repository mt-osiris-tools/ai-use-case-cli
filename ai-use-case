#!/bin/bash
# AI Use Case - CLI Tool
#
# IMPORTANT: This CLI is deprecated in v3.0.0+
# Please use Claude Code slash commands instead
#
# Available slash commands:
#   /use-case:setup-project      - Setup current project
#   /use-case:document-session   - Document an AI session
#   /use-case:sync-usecases      - Sync use cases to hub
#   /use-case:search-usecases    - Search use cases
#   /use-case:publish-confluence - Publish to Confluence
#   /use-case:quick-start        - Quick start guide

set -e

# Colors
GREEN=$'\033[0;32m'
BLUE=$'\033[0;34m'
YELLOW=$'\033[1;33m'
RED=$'\033[0;31m'
CYAN=$'\033[0;36m'
NC=$'\033[0m'

# Version
VERSION="3.1.0"

# Show deprecation notice
show_deprecation() {
    cat <<EOF
${YELLOW}╭────────────────────────────────────────────────────────────╮${NC}
${YELLOW}│${NC}  ${RED}⚠ DEPRECATION NOTICE${NC}                                   ${YELLOW}│${NC}
${YELLOW}│${NC}                                                            ${YELLOW}│${NC}
${YELLOW}│${NC}  Standalone CLI commands have been removed in v3.0.0      ${YELLOW}│${NC}
${YELLOW}│${NC}                                                            ${YELLOW}│${NC}
${YELLOW}│${NC}  ${BLUE}Please use Claude Code slash commands instead:${NC}        ${YELLOW}│${NC}
${YELLOW}│${NC}                                                            ${YELLOW}│${NC}
${YELLOW}│${NC}  ${GREEN}/use-case:setup-project${NC}      - Setup project           ${YELLOW}│${NC}
${YELLOW}│${NC}  ${GREEN}/use-case:document-session${NC}   - Document AI session    ${YELLOW}│${NC}
${YELLOW}│${NC}  ${GREEN}/use-case:sync-usecases${NC}      - Sync to hub            ${YELLOW}│${NC}
${YELLOW}│${NC}  ${GREEN}/use-case:search-usecases${NC}    - Search use cases       ${YELLOW}│${NC}
${YELLOW}│${NC}  ${GREEN}/use-case:publish-confluence${NC} - Publish to Confluence  ${YELLOW}│${NC}
${YELLOW}│${NC}  ${GREEN}/use-case:quick-start${NC}        - Quick start guide      ${YELLOW}│${NC}
${YELLOW}│${NC}                                                            ${YELLOW}│${NC}
${YELLOW}│${NC}  ${CYAN}More info:${NC} https://github.com/mt-osiris-tools/         ${YELLOW}│${NC}
${YELLOW}│${NC}             ai-use-case-cli                                ${YELLOW}│${NC}
${YELLOW}╰────────────────────────────────────────────────────────────╯${NC}

EOF
}

# Show help (updated for v3)
show_help() {
    show_deprecation
    cat <<EOF
${BLUE}ai-use-case v${VERSION}${NC}

${YELLOW}This tool is now designed to work exclusively with Claude Code.${NC}

${YELLOW}Installation Status:${NC}
  Scripts location: $(dirname "$0")
  Version: $VERSION

${YELLOW}Available Slash Commands in Claude Code:${NC}
  ${GREEN}/use-case:setup-project${NC}      Setup current project
  ${GREEN}/use-case:document-session${NC}   Document AI-assisted session
  ${GREEN}/use-case:sync-usecases${NC}      Sync use cases to hub
  ${GREEN}/use-case:search-usecases${NC}    Search documented use cases
  ${GREEN}/use-case:publish-confluence${NC} Publish to Confluence
  ${GREEN}/use-case:quick-start${NC}        Quick start guide

${YELLOW}Direct Script Access (Advanced):${NC}
If you need to call scripts directly, they are available at:
  $(dirname "$0")/setup-project.sh
  $(dirname "$0")/document-ai-session.sh
  $(dirname "$0")/sync-ai-use-cases.sh
  $(dirname "$0")/search-use-cases.sh
  $(dirname "$0")/stats-use-cases.sh
  $(dirname "$0")/list-projects.sh
  $(dirname "$0")/view-hub.sh
  $(dirname "$0")/push-hub.sh
  $(dirname "$0")/publish-confluence.sh

${YELLOW}Why This Change?${NC}
v3.0.0 focuses on integration with Claude Code for a more seamless
AI-assisted development workflow. The slash command interface provides
better context awareness and automatic documentation generation.

${YELLOW}Need Help?${NC}
  GitHub: https://github.com/mt-osiris-tools/ai-use-case-cli
  Issues: https://github.com/mt-osiris-tools/ai-use-case-cli/issues

EOF
}

# Parse command
case "${1:-}" in
    --help|-h|help|"")
        show_help
        exit 0
        ;;
    --version|-v)
        echo "ai-use-case version $VERSION"
        exit 0
        ;;
    version)
        echo "${BLUE}ai-use-case${NC} version ${GREEN}$VERSION${NC}"
        echo ""
        echo "${YELLOW}Note:${NC} Standalone commands removed in v3.0.0"
        echo "Please use Claude Code slash commands instead"
        echo ""
        echo "Run ${CYAN}ai-use-case --help${NC} for more information"
        exit 0
        ;;
    *)
        show_deprecation
        echo ""
        echo "${RED}Error: Standalone command '$1' is no longer supported${NC}"
        echo ""
        echo "Please use Claude Code slash commands instead."
        echo "Run ${CYAN}ai-use-case --help${NC} for more information."
        echo ""
        exit 1
        ;;
esac
