#!/bin/bash
# AI Use Case - CLI Tool
#
# Hybrid CLI and Claude Code integration for AI use case documentation
# - Standalone commands for utility operations
# - Claude Code slash commands for AI-context-aware operations

set -e

# Colors
GREEN=$'\033[0;32m'
BLUE=$'\033[0;34m'
YELLOW=$'\033[1;33m'
RED=$'\033[0;31m'
CYAN=$'\033[0;36m'
NC=$'\033[0m'

# Get script directory (resolve symlinks)
SCRIPT_PATH="${BASH_SOURCE[0]}"
if [ -L "$SCRIPT_PATH" ]; then
    SCRIPT_PATH="$(readlink -f "$SCRIPT_PATH")"
fi
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

# Source version configuration (single source of truth)
if [ -f "$SCRIPT_DIR/scripts/utils/version.sh" ]; then
    source "$SCRIPT_DIR/scripts/utils/version.sh"
    VERSION="$CLI_VERSION"
else
    # Fallback if version.sh is missing
    echo "Warning: version.sh not found, using fallback version" >&2
    VERSION="unknown"
fi

# Show help
show_help() {
    cat <<EOF
${BLUE}╭────────────────────────────────────────────────────────────╮${NC}
${BLUE}│${NC} ${GREEN}AI Use Case CLI${NC} v${VERSION}                                ${BLUE}│${NC}
${BLUE}│${NC} Document AI workflows, build knowledge                 ${BLUE}│${NC}
${BLUE}╰────────────────────────────────────────────────────────────╯${NC}

${YELLOW}USAGE${NC}
  ai-use-case <command> [options]

${YELLOW}COMMANDS${NC}
  ${GREEN}--init, init${NC}              Setup current project for use case tracking
  ${GREEN}config [show|reconfigure]${NC} Show or reconfigure hub settings
  ${GREEN}sync${NC}                      Sync use cases from project to hub
  ${GREEN}search <term>${NC}             Search documented use cases
  ${GREEN}list${NC}                      List all registered projects
  ${GREEN}stats${NC}                     View use case statistics
  ${GREEN}view${NC}                      Open hub directory in file explorer
  ${GREEN}push${NC}                      Push hub changes to remote repository
  ${GREEN}publish-confluence${NC}        Publish use case to Confluence
  ${GREEN}bump-version <type>${NC}       Bump version (major|minor|patch)
  ${GREEN}uninstall${NC}                 Uninstall the CLI tool
  ${GREEN}--version, -v, version${NC}    Show version information
  ${GREEN}--help, -h, help${NC}          Show this help message

${YELLOW}CLAUDE CODE INTEGRATION${NC}
  For AI-assisted documentation with automatic context capture:
  ${GREEN}/use-case:document-session${NC}   Document AI session (automatic)
  ${GREEN}/use-case:setup-project${NC}      Setup project (alternative to --init)
  ${GREEN}/use-case:sync-usecases${NC}      Sync to hub (alternative to sync)
  ${GREEN}/use-case:search-usecases${NC}    Search (alternative to search)
  ${GREEN}/use-case:publish-confluence${NC} Publish (alternative)
  ${GREEN}/use-case:quick-start${NC}        Quick start guide

${YELLOW}EXAMPLES${NC}
  ai-use-case --init              # Setup current project
  ai-use-case config show         # Show current hub configuration
  ai-use-case config reconfigure  # Change hub mode (local/private)
  ai-use-case sync                # Sync use cases to hub
  ai-use-case search "auth"       # Search for auth-related use cases
  ai-use-case list                # List all projects
  ai-use-case stats               # View statistics

${YELLOW}PROJECT REGISTRY (v3.1.0+)${NC}
  ${GREEN}list-projects${NC}             List registered projects with versions
  ${GREEN}check-updates${NC}             Check which projects need CLI updates
  ${GREEN}update-project <path>${NC}     Update project to latest CLI version

${YELLOW}ENVIRONMENT${NC}
  AI_USECASES_DIR      Hub directory (default: ~/Documents/ai-use-case-hub)

${YELLOW}MORE INFO${NC}
  GitHub: ${CYAN}https://github.com/mt-osiris-tools/ai-use-case-cli${NC}
  Issues: ${CYAN}https://github.com/mt-osiris-tools/ai-use-case-cli/issues${NC}

EOF
}

# Parse command
case "${1:-}" in
    --help|-h|help|"")
        show_help
        exit 0
        ;;
    --version|-v)
        echo "ai-use-case version $VERSION"
        exit 0
        ;;
    version)
        echo "${BLUE}ai-use-case${NC} version ${GREEN}$VERSION${NC}"
        exit 0
        ;;
    --init|init)
        echo -e "${BLUE}Setting up project...${NC}"
        if [ -f "$SCRIPT_DIR/scripts/project/setup-project.sh" ]; then
            bash "$SCRIPT_DIR/scripts/project/setup-project.sh" .
        else
            echo -e "${RED}Error: setup-project.sh not found${NC}"
            exit 1
        fi
        ;;
    config)
        if [ -f "$SCRIPT_DIR/scripts/utils/config-manager.sh" ]; then
            case "${2:-show}" in
                show)
                    bash "$SCRIPT_DIR/scripts/utils/config-manager.sh" show
                    ;;
                reconfigure)
                    CONFIG_FILE="$HOME/.config/ai-use-case-cli/config.json"
                    if [ -f "$CONFIG_FILE" ]; then
                        echo -e "${YELLOW}Current configuration will be replaced.${NC}"
                        echo ""
                        bash "$SCRIPT_DIR/scripts/utils/config-manager.sh" show
                        echo ""
                        read -p "Continue with reconfiguration? (y/n) " -n 1 -r
                        echo
                        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                            echo -e "${BLUE}Reconfiguration cancelled${NC}"
                            exit 0
                        fi
                        rm "$CONFIG_FILE"
                        echo -e "${GREEN}✓${NC} Previous configuration removed"
                        echo ""
                    fi
                    bash "$SCRIPT_DIR/scripts/utils/config-manager.sh" init
                    ;;
                *)
                    echo -e "${RED}Error: Unknown config command '${2}'${NC}"
                    echo "Usage: ai-use-case config [show|reconfigure]"
                    exit 1
                    ;;
            esac
        else
            echo -e "${RED}Error: config-manager.sh not found${NC}"
            exit 1
        fi
        ;;
    sync)
        echo -e "${BLUE}Syncing use cases to hub...${NC}"
        if [ -f "$SCRIPT_DIR/scripts/core/sync-ai-use-cases.sh" ]; then
            bash "$SCRIPT_DIR/scripts/core/sync-ai-use-cases.sh" .
        else
            echo -e "${RED}Error: sync-ai-use-cases.sh not found${NC}"
            exit 1
        fi
        ;;
    search)
        if [ -z "${2:-}" ]; then
            echo -e "${RED}Error: Search term required${NC}"
            echo "Usage: ai-use-case search <term>"
            exit 1
        fi
        if [ -f "$SCRIPT_DIR/scripts/search/search-use-cases.sh" ]; then
            bash "$SCRIPT_DIR/scripts/search/search-use-cases.sh" "$2"
        else
            echo -e "${RED}Error: search-use-cases.sh not found${NC}"
            exit 1
        fi
        ;;
    list)
        if [ -f "$SCRIPT_DIR/scripts/project/list-projects.sh" ]; then
            bash "$SCRIPT_DIR/scripts/project/list-projects.sh"
        else
            echo -e "${RED}Error: list-projects.sh not found${NC}"
            exit 1
        fi
        ;;
    stats)
        if [ -f "$SCRIPT_DIR/scripts/search/stats-use-cases.sh" ]; then
            bash "$SCRIPT_DIR/scripts/search/stats-use-cases.sh"
        else
            echo -e "${RED}Error: stats-use-cases.sh not found${NC}"
            exit 1
        fi
        ;;
    view)
        if [ -f "$SCRIPT_DIR/scripts/hub/view-hub.sh" ]; then
            bash "$SCRIPT_DIR/scripts/hub/view-hub.sh"
        else
            echo -e "${RED}Error: view-hub.sh not found${NC}"
            exit 1
        fi
        ;;
    push)
        if [ -f "$SCRIPT_DIR/scripts/hub/push-hub.sh" ]; then
            bash "$SCRIPT_DIR/scripts/hub/push-hub.sh"
        else
            echo -e "${RED}Error: push-hub.sh not found${NC}"
            exit 1
        fi
        ;;
    publish-confluence)
        if [ -f "$SCRIPT_DIR/scripts/core/publish-confluence.sh" ]; then
            bash "$SCRIPT_DIR/scripts/core/publish-confluence.sh" "${2:-}"
        else
            echo -e "${RED}Error: publish-confluence.sh not found${NC}"
            exit 1
        fi
        ;;
    list-projects)
        if [ -f "$SCRIPT_DIR/scripts/project/list-projects.sh" ]; then
            bash "$SCRIPT_DIR/scripts/project/list-projects.sh" "${2:-}"
        else
            echo -e "${RED}Error: list-projects.sh not found${NC}"
            exit 1
        fi
        ;;
    check-updates)
        if [ -f "$SCRIPT_DIR/scripts/project/check-updates.sh" ]; then
            bash "$SCRIPT_DIR/scripts/project/check-updates.sh" "${2:-}"
        else
            echo -e "${RED}Error: check-updates.sh not found${NC}"
            exit 1
        fi
        ;;
    update-project)
        if [ -z "${2:-}" ]; then
            echo -e "${RED}Error: Project path required${NC}"
            echo "Usage: ai-use-case update-project <path>"
            exit 1
        fi
        if [ -f "$SCRIPT_DIR/scripts/project/update-project.sh" ]; then
            bash "$SCRIPT_DIR/scripts/project/update-project.sh" "$2"
        else
            echo -e "${RED}Error: update-project.sh not found${NC}"
            exit 1
        fi
        ;;
    bump-version|bump)
        if [ -z "${2:-}" ]; then
            echo -e "${RED}Error: Bump type required${NC}"
            echo "Usage: ai-use-case bump-version [major|minor|patch|X.Y.Z] [options]"
            echo "Run: ai-use-case bump-version --help for more information"
            exit 1
        fi
        if [ -f "$SCRIPT_DIR/scripts/utils/bump-version.sh" ]; then
            # Pass all arguments after the command to the script
            shift
            bash "$SCRIPT_DIR/scripts/utils/bump-version.sh" "$@"
        else
            echo -e "${RED}Error: bump-version.sh not found${NC}"
            exit 1
        fi
        ;;
    uninstall)
        if [ -f "$SCRIPT_DIR/scripts/install/uninstall.sh" ]; then
            bash "$SCRIPT_DIR/scripts/install/uninstall.sh"
        else
            echo -e "${RED}Error: uninstall.sh not found${NC}"
            exit 1
        fi
        ;;
    document)
        # Document command removed in v3.0.0 - now uses Claude Code
        cat <<EOF
${YELLOW}╭────────────────────────────────────────────────────────────╮${NC}
${YELLOW}│${NC}  ${RED}⚠ COMMAND CHANGED${NC}                                      ${YELLOW}│${NC}
${YELLOW}│${NC}                                                            ${YELLOW}│${NC}
${YELLOW}│${NC}  The 'document' command now requires Claude Code for     ${YELLOW}│${NC}
${YELLOW}│${NC}  automatic context capture and documentation generation. ${YELLOW}│${NC}
${YELLOW}│${NC}                                                            ${YELLOW}│${NC}
${YELLOW}│${NC}  ${BLUE}Please use:${NC}                                            ${YELLOW}│${NC}
${YELLOW}│${NC}  ${GREEN}/use-case:document-session${NC}                            ${YELLOW}│${NC}
${YELLOW}│${NC}                                                            ${YELLOW}│${NC}
${YELLOW}│${NC}  This provides better AI-assisted documentation with     ${YELLOW}│${NC}
${YELLOW}│${NC}  automatic git history analysis and context awareness.   ${YELLOW}│${NC}
${YELLOW}╰────────────────────────────────────────────────────────────╯${NC}

EOF
        exit 1
        ;;
    *)
        echo -e "${RED}Error: Unknown command '${1}'${NC}"
        echo ""
        echo "Run ${CYAN}ai-use-case --help${NC} for available commands"
        exit 1
        ;;
esac
