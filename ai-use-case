#!/bin/bash
# AI Use Case - Unified CLI Tool
# Simple interface for documenting AI-assisted development workflows
#
# Usage:
#   ai-use-case --init          Setup current project
#   ai-use-case document        Document an AI session
#   ai-use-case sync            Sync use cases to hub
#   ai-use-case search <term>   Search use cases
#   ai-use-case --help          Show help

set -e

# Colors
GREEN=$'\033[0;32m'
BLUE=$'\033[0;34m'
YELLOW=$'\033[1;33m'
RED=$'\033[0;31m'
NC=$'\033[0m'

# Function to ensure hub repository exists
ensure_hub_exists() {
    local hub_dir
    local default_hub="$HOME/Documents/ai-use-case-hub"

    # Check if AI_USECASES_DIR is set
    if [ -n "$AI_USECASES_DIR" ]; then
        hub_dir="$AI_USECASES_DIR"
    else
        hub_dir="$default_hub"
    fi

    # Check if hub exists
    if [ ! -d "$hub_dir" ]; then
        echo -e "${YELLOW}Hub repository not found at: $hub_dir${NC}" >&2
        echo -e "${BLUE}Cloning ai-use-case-hub repository...${NC}" >&2

        # Create parent directory if needed
        mkdir -p "$(dirname "$hub_dir")"

        # Clone the repository
        if git clone https://github.com/mt-osiris-tools/ai-use-case-hub.git "$hub_dir" 2>/dev/null; then
            echo -e "${GREEN}✓${NC} Hub repository cloned successfully" >&2
        else
            echo -e "${RED}Error: Failed to clone hub repository${NC}" >&2
            echo "Please clone manually:" >&2
            echo "  git clone https://github.com/mt-osiris-tools/ai-use-case-hub.git $hub_dir" >&2
            exit 1
        fi
    fi

    # Verify hub structure
    if [ ! -d "$hub_dir/by-project" ]; then
        mkdir -p "$hub_dir/by-project" "$hub_dir/by-date" "$hub_dir/by-topic"
    fi

    echo "$hub_dir"
}

# Detect script location (follow symlinks to find actual script directory)
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_SOURCE" ]; do
    SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
    SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
    [[ $SCRIPT_SOURCE != /* ]] && SCRIPT_SOURCE="$SCRIPT_DIR/$SCRIPT_SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"

# Ensure hub exists
HUB_DIR=$(ensure_hub_exists)

# Show version
VERSION="2.3.0"

# Version check cache
VERSION_CHECK_FILE="$HOME/.cache/ai-use-case-version-check"
VERSION_CHECK_INTERVAL=86400  # 24 hours in seconds

# Helper function: Fetch remote version from GitHub
# Usage: fetch_remote_version <timeout_seconds>
# Returns: Version string via stdout, or empty if failed
fetch_remote_version() {
    local timeout="${1:-2}"
    local remote_version=""

    if command -v curl &> /dev/null; then
        remote_version=$(curl -s -m "$timeout" https://raw.githubusercontent.com/mt-osiris-tools/ai-use-case-cli/main/ai-use-case 2>/dev/null | grep '^VERSION=' | head -1 | cut -d'"' -f2)
    elif command -v wget &> /dev/null; then
        remote_version=$(wget -qO- -T "$timeout" https://raw.githubusercontent.com/mt-osiris-tools/ai-use-case-cli/main/ai-use-case 2>/dev/null | grep '^VERSION=' | head -1 | cut -d'"' -f2)
    fi

    echo "$remote_version"
}

# Helper function: Compare semantic versions
# Usage: compare_versions v1 v2
# Returns: 0 if v1 < v2 (update available), 1 if v1 >= v2 (no update needed)
compare_versions() {
    local v1="$1"
    local v2="$2"

    # If versions are equal, no update needed
    if [ "$v1" = "$v2" ]; then
        return 1
    fi

    # Split versions into components
    local IFS='.'
    local v1_parts=($v1)
    local v2_parts=($v2)

    # Compare major, minor, patch
    for i in 0 1 2; do
        local v1_part="${v1_parts[$i]:-0}"
        local v2_part="${v2_parts[$i]:-0}"

        if [ "$v1_part" -lt "$v2_part" ]; then
            return 0  # v1 < v2, update available
        elif [ "$v1_part" -gt "$v2_part" ]; then
            return 1  # v1 > v2, no update needed
        fi
    done

    # Versions are equal
    return 1
}

# Function to check for updates
check_for_updates() {
    # Skip if we checked recently
    if [ -f "$VERSION_CHECK_FILE" ]; then
        local last_check=$(cat "$VERSION_CHECK_FILE" 2>/dev/null || echo "0")
        local now=$(date +%s)
        local elapsed=$((now - last_check))

        if [ $elapsed -lt $VERSION_CHECK_INTERVAL ]; then
            return 0
        fi
    fi

    # Try to fetch latest version from GitHub (2 second timeout for background check)
    local remote_version=$(fetch_remote_version 2)

    # Update check timestamp
    mkdir -p "$(dirname "$VERSION_CHECK_FILE")"
    date +%s > "$VERSION_CHECK_FILE" 2>/dev/null || true

    # Compare versions if we got a remote version
    if [ -n "$remote_version" ] && compare_versions "$VERSION" "$remote_version"; then
        echo -e "${YELLOW}╭────────────────────────────────────────────────────╮${NC}" >&2
        echo -e "${YELLOW}│${NC} Update available: ${GREEN}v$remote_version${NC} (current: v$VERSION)" >&2
        echo -e "${YELLOW}│${NC} Run: ${BLUE}cd ~/.local/share/ai-use-case-cli && git pull${NC}" >&2
        echo -e "${YELLOW}╰────────────────────────────────────────────────────╯${NC}" >&2
        echo "" >&2
    fi
}

# Show help
show_help() {
    cat <<EOF
${BLUE}ai-use-case${NC} - Document AI-assisted development workflows

${YELLOW}Version:${NC} $VERSION

${YELLOW}Usage:${NC}
  ai-use-case [command] [options]

${YELLOW}Commands:${NC}
  ${GREEN}--init, init${NC}              Setup current project for AI use cases
  ${GREEN}document, doc${NC}             Document an AI-assisted session (interactive)
  ${GREEN}sync${NC}                      Sync use cases from current project to hub
  ${GREEN}push${NC}                      Commit and push hub changes to remote repository
  ${GREEN}publish-confluence${NC}        Publish use case to Confluence as child page
  ${GREEN}search <term>${NC}             Search all use cases for a keyword/topic
  ${GREEN}view${NC}                      View use cases in hub (opens file explorer)
  ${GREEN}list${NC}                      List all projects with use cases
  ${GREEN}stats${NC}                     Show statistics about documented use cases
  ${GREEN}version${NC}                   Show detailed version info and check for updates
  ${GREEN}--help, -h${NC}                Show this help message
  ${GREEN}--version, -v${NC}             Show version number (quick)

${YELLOW}Examples:${NC}
