# Editor and IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.log

# Local drafts (should not be in central repo anyway)
*.draft.md
*.local.md

# Use Case Documentation - ignore entire directory and all content (for local testing)
.usecase/
.usecase/*
.usecase/**/*

# Note: by-project/, by-date/, and by-topic/ directories
# belong in the ai-use-case-hub repository, not this CLI tools repo
.claude/presentation-*.md
.claude/commands/
__pycache__/

# User data files (created during CLI usage)
projects-registry.json
config.json
tracing.json

# Python virtual environment (created by tracing setup)
venv/
*.pyc
