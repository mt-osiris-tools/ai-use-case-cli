@startuml Publish Confluence Flow
!define RECTANGLE class

skinparam backgroundColor #FEFEFE
skinparam activity {
  BackgroundColor<< Success >> #90EE90
  BackgroundColor<< Action >> #87CEEB
  BackgroundColor<< Confluence >> #B0C4DE
  BorderColor #333333
  FontSize 12
}

title AI Use Case CLI - Publish to Confluence

start

:User runs ai-use-case publish-confluence [file];

if (File specified?) then (no)
  :List available use case files;

  :Prompt user to select file;
else (yes)
  :Use specified file;
endif

:Read markdown file;

:Parse front matter and content;
note right
  Extract:
  - Title
  - Metadata
  - Content sections
end note

partition "Confluence Integration" #LightBlue {
  :Check Atlassian MCP tools available;

  if (MCP tools available?) then (yes)
    :Authenticate with Atlassian;

    :Get accessible resources;
    note right
      Cloud IDs and spaces
    end note

    :Prompt for target space << Confluence >>;

    :Convert markdown to Confluence format;
    note right
      - Markdown → ADF (Atlassian Document Format)
      - Preserve formatting
      - Handle code blocks
      - Convert tables
    end note

    :Create or update page << Confluence >>;

    if (Page exists?) then (yes)
      :Update existing page;
      :Add version comment;
    else (no)
      :Create new page;
    endif

    :Get page URL;

    :Display success message << Success >>;
    note right
      ✓ Published to Confluence
      Page: [URL]
      Space: [space name]
    end note
  else (no)
    :Error: Atlassian MCP not configured;
    note right
      Setup required:
      - Install MCP server
      - Configure in Claude Code
    end note
    stop
  endif
}

stop

@enduml
